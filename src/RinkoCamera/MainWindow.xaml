<Window x:Class="RinkoCamera.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RinkoCamera.Core;assembly=RinkoCamera.Core"
        Title="RinkoCamera · TSUKI" Icon="Assets/tsuki.ico" Style="{StaticResource {x:Type Window}}"
        Height="860" Width="1220" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate x:Key="QualityLabel">
            <TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Text" Value="均衡"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Static core:VideoQuality.Low}"><Setter Property="Text" Value="节省空间"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="{x:Static core:VideoQuality.High}"><Setter Property="Text" Value="清晰优先"/></DataTrigger>
                </Style.Triggers>
            </Style></TextBlock.Style></TextBlock>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#DED7E8" BorderThickness="0,0,1,0" ClipToBounds="True">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E7E0F0"/><GradientStop Color="#F0EBF6" Offset="0.55"/><GradientStop Color="#D9EAF0" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="22,25,22,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <DockPanel>
                        <Image Source="Assets/tsuki-icon.png" Width="38" Height="38" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="RinkoCamera" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="TSUKI EDITION" FontSize="9" Foreground="#82728F" Margin="1,5,0,0" FontFamily="Segoe UI"/></StackPanel>
                    </DockPanel>
                    <Border Background="#7FFFFFFF" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal"><Ellipse Fill="#669B92" Width="6" Height="6" Margin="0,0,6,0"/><TextBlock Text="完全本地 · 安心记录" FontSize="10" Foreground="#567B79"/></StackPanel>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1" Margin="-20,12,-20,4">
                    <Ellipse Width="210" Height="210" Fill="#60FFFFFF" VerticalAlignment="Center"/>
                    <Image Source="Assets/tsuki-hero.png" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="TSUKI 原创角色立绘" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Grid.Row="2" Margin="2,12,0,0">
                    <TextBlock Text="TSUKI" FontFamily="Georgia" FontSize="30" Foreground="#64536F"/>
                    <TextBlock Text="(｡･ω･｡)ﾉ♡" FontSize="16" Foreground="#82728F" Margin="0,7,0,0"/>
                    <Border Height="1" Background="#C8BFDA" Margin="0,18,32,13"/>
                    <TextBlock Text="无需账号  /  无上传  /  无遥测" FontSize="10" Foreground="#82728F"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="24,25,24,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,22">
                <StackPanel><TextBlock Text="记录此刻" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="选好画面与声音，剩下的交给 TSUKI。" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,4,0,0"><TextBlock Text="MP4  ·  H.264 / AAC" FontSize="11" Foreground="{StaticResource MutedInk}" FontFamily="Segoe UI"/></Border>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="284"/></Grid.ColumnDefinitions>
                <!-- Only settings scroll; recording controls always remain in view. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel IsEnabled="{Binding CanEditSettings}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="↻  刷新窗口" Command="{Binding RefreshTargetsCommand}" MinHeight="28" Padding="9,3" FontSize="11"/><TextBlock Text="01   录制画面" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/></DockPanel>
                                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="DisplayName" AutomationProperties.Name="录制目标" ToolTip="{Binding SelectedTarget.DisplayName}"/>
                                <TextBlock Text="支持指定窗口、显示器与全屏" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="02   录制声音" Style="{StaticResource CardTitle}"/>
                                <ComboBox ItemsSource="{Binding AudioModes}" SelectedValue="{Binding AudioMode}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="声音来源"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="系统声音 · 播放设备" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding SystemDevices}" SelectedItem="{Binding SelectedSystemDevice}" DisplayMemberPath="Name" AutomationProperties.Name="系统声音设备" ToolTip="{Binding SelectedSystemDevice.Name}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="麦克风" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name" AutomationProperties.Name="麦克风设备" ToolTip="{Binding SelectedMicrophone.Name}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="03   画质与倒计时" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="分辨率" Style="{StaticResource FieldLabel}"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="视频宽度"/>
                                            <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}"/>
                                            <TextBox Grid.Column="2" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="视频高度"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="帧率 · FPS" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding FrameRate}" AutomationProperties.Name="录制帧率"/></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="视频质量" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" ItemTemplate="{StaticResource QualityLabel}" AutomationProperties.Name="视频质量"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="倒计时 · 秒（0 为关闭）" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding CountdownValues}" SelectedItem="{Binding CountdownSeconds}" AutomationProperties.Name="倒计时秒数"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="04   保存位置" Style="{StaticResource CardTitle}"/>
                                <DockPanel><Button DockPanel.Dock="Right" Content="浏览" Command="{Binding ChooseDirectoryCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="保存目录" ToolTip="{Binding OutputDirectory}"/></DockPanel>
                                <TextBlock Text="日期时间自动命名，完成后保存为 MP4。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#8AA9A2"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Fill" Value="#C77189"/></DataTrigger><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Fill" Value="#C0995B"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                    <TextBlock Text="录制状态" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CaptureModeText}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="#F7F4FB" CornerRadius="14" Padding="8,22" Margin="0,22,0,18">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" Foreground="#9685A4" FontSize="11" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="录 制 时 长"/><Style.Triggers><DataTrigger Binding="{Binding IsCountingDown}" Value="True"><Setter Property="Text" Value="即 将 开 始"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <Grid>
                                        <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="39" Foreground="#625075" AutomationProperties.Name="录制时长"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCountingDown}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <TextBlock Text="{Binding CountdownRemaining}" FontSize="39" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" AutomationProperties.Name="录制倒计时"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCountingDown}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusText}" FontSize="14" TextWrapping="Wrap" LineHeight="23" AutomationProperties.Name="当前状态"/>
                                    <TextBlock Text="{Binding ErrorText}" Foreground="#AC3C57" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21" AutomationProperties.Name="错误信息"/>
                                    <TextBlock Text="声音电平" Style="{StaticResource Hint}" Margin="0,16,0,7"/>
                                    <ProgressBar Value="{Binding AudioLevel}" Maximum="100" Height="6" AutomationProperties.Name="录音电平"/>
                                    <TextBlock Text="{Binding AudioStatusText}" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="3">
                                <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="开始录制"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#F1B4C7" Margin="0,0,9,0"/><TextBlock Text="开始录制"/></StackPanel></Button>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid>
                                        <Button Content="Ⅱ  暂停" Command="{Binding PauseCommand}" AutomationProperties.Name="暂停录制"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                        <Button Content="▷  继续" Command="{Binding ResumeCommand}" AutomationProperties.Name="继续录制"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                    </Grid>
                                    <Button Grid.Column="2" Content="■  停止" Command="{Binding StopCommand}" Foreground="#A94862" Background="#FAEBEF" AutomationProperties.Name="停止录制"/>
                                </Grid>
                                <Border Background="#F6F4F9" CornerRadius="8" Padding="6,10" Margin="0,14,0,0"><StackPanel><TextBlock Text="Ctrl + Shift + F10" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center" Foreground="#7A668E"/><TextBlock Text="全局开始 / 停止快捷键" FontSize="10" HorizontalAlignment="Center" Foreground="#8E849A" Margin="0,4,0,0"/></StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="↗  打开视频" Command="{Binding OpenFileCommand}" FontSize="12" AutomationProperties.Name="打开文件"/><Button Grid.Column="2" Content="▱  所在目录" Command="{Binding OpenFolderCommand}" FontSize="12" AutomationProperties.Name="打开目录"/></Grid>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="2" Text="录制时窗口保持显示 · 你可以手动最小化，使用全局快捷键停止录制。" Style="{StaticResource Hint}" FontSize="10" Margin="2,13,0,0"/>
        </Grid>
    </Grid>
</Window>
